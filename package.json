{
  "name": "vokabelgarten",
  "version": "1.0.0",
  "private": true,
  "description": "Private Englisch-Vokabel-Lernapp (PWA) mit Foto-Erkennung über die Claude API",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "postinstall": "node scripts/vendor.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:browser": "node test/e2e/browser.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "express": "^5.3.0",
    "tesseract.js": "^7.0.0"
  }
}
